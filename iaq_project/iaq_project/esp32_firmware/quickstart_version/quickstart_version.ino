/*
  Indoor Air Quality Predictor — QUICKSTART VERSION
  ---------------------------------------------------
  This sketch reads DHT22 (temp/humidity) + MQ-135 (gas, through a level
  shifter), runs a tiny neural network DIRECTLY as plain C code (no
  TensorFlow Lite Micro / EloquentTinyML runtime required), and shows the
  predicted air-quality class on the Serial monitor and a small built-in
  web dashboard.

  This exists so you have a fully working, flashable system on day one.
  model_weights.h was generated by train_model_quickstart.py from a
  SYNTHETIC dataset — replace it with weights trained on your own collected
  data before you rely on it for real results (see README.md).

  Once your project specifically needs to demonstrate EloquentTinyML +
  TensorFlow Lite Micro (to match the project title), use the sketch in
  ../eloquenttinyml_version/ instead — same sensor code, different
  inference backend.

  ------------------------------- WIRING ---------------------------------
  DHT22:
    VCC  -> 3.3V
    GND  -> GND
    DATA -> GPIO 4   (DHTPIN below)  [add a 10k pull-up to 3.3V if needed]

  MQ-135 (through your level shifter):
    VCC  -> 5V (module has its own regulator/heater)
    GND  -> GND
    AOUT -> level shifter HV side in, level shifter LV side out -> GPIO 34
            (ADC1 input-only pin, safe on ESP32)
  --------------------------------------------------------------------- */

#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>
#include "model_weights.h"

// ---------------------- CONFIG ----------------------
#define DHTPIN 4
#define DHTTYPE DHT22
#define MQ135_PIN 34

// Wi-Fi: the ESP32 hosts its own access point so you don't need to know
// your lab's Wi-Fi credentials for a demo. Connect a laptop/phone to this
// network and browse to 192.168.4.1
const char* AP_SSID = "IAQ-Predictor";
const char* AP_PASSWORD = "airquality123";

const unsigned long READ_INTERVAL_MS = 3000;
// ------------------------------------------------------

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

struct Reading {
  float temperature;
  float humidity;
  float gas;
  bool valid;
};

struct Prediction {
  int classIndex;
  float probs[IAQ_N_CLASSES];
};

Reading lastReading = {0, 0, 0, false};
Prediction lastPrediction = {0, {0, 0, 0}};

// ---------------- Sensor reading ----------------
Reading readSensors() {
  Reading r;
  r.temperature = dht.readTemperature();
  r.humidity = dht.readHumidity();
  r.valid = !(isnan(r.temperature) || isnan(r.humidity));

  int raw = analogRead(MQ135_PIN);         // 0-4095 on ESP32's 12-bit ADC
  r.gas = (float)raw;

  return r;
}

// ---------------- Tiny neural net forward pass ----------------
// Implements: normalize -> Dense+ReLU (x N hidden layers) -> Dense -> softmax
// matching the sklearn MLPClassifier exported by train_model_quickstart.py
Prediction predictAirQuality(const Reading& r) {
  float x[IAQ_N_FEATURES] = {r.temperature, r.humidity, r.gas};

  // normalize using the training-set mean/std baked into model_weights.h
  float norm[IAQ_N_FEATURES];
  for (int i = 0; i < IAQ_N_FEATURES; i++) {
    norm[i] = (x[i] - iaq_feature_mean[i]) / iaq_feature_std[i];
  }

  // Layer 0: IAQ_N_FEATURES -> 16, ReLU
  float h0[16];
  for (int j = 0; j < iaq_layer_sizes[1]; j++) {
    float acc = iaq_b0[j];
    for (int i = 0; i < IAQ_N_FEATURES; i++) acc += norm[i] * iaq_W0[i][j];
    h0[j] = acc > 0 ? acc : 0.0f;  // ReLU
  }

  // Layer 1: 16 -> 8, ReLU
  float h1[8];
  for (int j = 0; j < iaq_layer_sizes[2]; j++) {
    float acc = iaq_b1[j];
    for (int i = 0; i < iaq_layer_sizes[1]; i++) acc += h0[i] * iaq_W1[i][j];
    h1[j] = acc > 0 ? acc : 0.0f;  // ReLU
  }

  // Layer 2: 8 -> IAQ_N_CLASSES, softmax
  float logits[IAQ_N_CLASSES];
  for (int j = 0; j < IAQ_N_CLASSES; j++) {
    float acc = iaq_b2[j];
    for (int i = 0; i < iaq_layer_sizes[2]; i++) acc += h1[i] * iaq_W2[i][j];
    logits[j] = acc;
  }

  Prediction pred;
  float maxLogit = logits[0];
  for (int j = 1; j < IAQ_N_CLASSES; j++) if (logits[j] > maxLogit) maxLogit = logits[j];
  float sumExp = 0;
  for (int j = 0; j < IAQ_N_CLASSES; j++) {
    pred.probs[j] = expf(logits[j] - maxLogit);
    sumExp += pred.probs[j];
  }
  int best = 0;
  for (int j = 0; j < IAQ_N_CLASSES; j++) {
    pred.probs[j] /= sumExp;
    if (pred.probs[j] > pred.probs[best]) best = j;
  }
  pred.classIndex = best;
  return pred;
}

// ---------------- Web dashboard ----------------
void handleRoot() {
  String cls = iaq_class_names[lastPrediction.classIndex];
  String color = cls == "Good" ? "#2ecc71" : (cls == "Moderate" ? "#f39c12" : "#e74c3c");

  String html = "<!DOCTYPE html><html><head><meta charset='utf-8'>";
  html += "<meta http-equiv='refresh' content='3'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<title>Indoor Air Quality</title>";
  html += "<style>body{font-family:sans-serif;background:#111;color:#eee;text-align:center;padding:40px}";
  html += ".card{background:#1c1c1c;border-radius:16px;padding:24px;max-width:360px;margin:0 auto}";
  html += ".status{font-size:2em;font-weight:bold;padding:16px;border-radius:12px;margin:16px 0}";
  html += ".row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #333}</style>";
  html += "</head><body><div class='card'><h2>Indoor Air Quality</h2>";
  html += "<div class='status' style='background:" + color + "'>" + cls + "</div>";
  html += "<div class='row'><span>Temperature</span><span>" + String(lastReading.temperature, 1) + " &deg;C</span></div>";
  html += "<div class='row'><span>Humidity</span><span>" + String(lastReading.humidity, 1) + " %</span></div>";
  html += "<div class='row'><span>Gas (raw ADC)</span><span>" + String(lastReading.gas, 0) + "</span></div>";
  html += "<h4>Confidence</h4>";
  for (int i = 0; i < IAQ_N_CLASSES; i++) {
    html += "<div class='row'><span>" + String(iaq_class_names[i]) + "</span><span>" + String(lastPrediction.probs[i] * 100, 1) + "%</span></div>";
  }
  html += "</div></body></html>";

  server.send(200, "text/html", html);
}

// ---------------- JSON API (for the standalone dashboard / faculty demo) ----------------
// Lets the browser-based dashboard (outside this ESP32's own web page) poll
// live readings over the local network instead of only simulating them.
void handleApiData() {
  server.sendHeader("Access-Control-Allow-Origin", "*");  // allow the dashboard page, served from elsewhere, to fetch() this

  String json = "{";
  json += "\"temperature\":" + String(lastReading.temperature, 2) + ",";
  json += "\"humidity\":" + String(lastReading.humidity, 2) + ",";
  json += "\"gas\":" + String(lastReading.gas, 1) + ",";
  json += "\"prediction\":\"" + String(iaq_class_names[lastPrediction.classIndex]) + "\",";
  json += "\"probs\":[";
  for (int i = 0; i < IAQ_N_CLASSES; i++) {
    json += String(lastPrediction.probs[i], 4);
    if (i < IAQ_N_CLASSES - 1) json += ",";
  }
  json += "],";
  json += "\"uptimeMs\":" + String(millis());
  json += "}";

  server.send(200, "application/json", json);
}

// ---------------- Setup / loop ----------------
unsigned long lastRead = 0;

void setup() {
  Serial.begin(115200);
  dht.begin();
  analogReadResolution(12);

  WiFi.softAP(AP_SSID, AP_PASSWORD);
  Serial.print("Access point started. Connect to Wi-Fi '");
  Serial.print(AP_SSID);
  Serial.println("' and browse to http://192.168.4.1");
  Serial.println("JSON API available at http://192.168.4.1/api/data");

  server.on("/", handleRoot);
  server.on("/api/data", handleApiData);
  server.begin();
}

void loop() {
  server.handleClient();

  if (millis() - lastRead >= READ_INTERVAL_MS) {
    lastRead = millis();
    Reading r = readSensors();

    if (!r.valid) {
      Serial.println("DHT22 read failed, skipping this cycle.");
      return;
    }

    lastReading = r;
    lastPrediction = predictAirQuality(r);

    Serial.println("----------------------------------------");
    Serial.printf("Temp: %.1f C   Hum: %.1f %%   Gas: %.0f\n",
                   r.temperature, r.humidity, r.gas);
    Serial.printf("Prediction: %s\n", iaq_class_names[lastPrediction.classIndex]);
    for (int i = 0; i < IAQ_N_CLASSES; i++) {
      Serial.printf("  %-10s %.1f%%\n", iaq_class_names[i], lastPrediction.probs[i] * 100);
    }
  }
}
