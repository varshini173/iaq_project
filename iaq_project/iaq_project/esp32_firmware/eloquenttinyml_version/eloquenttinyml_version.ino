/*
  Indoor Air Quality Predictor — EloquentTinyML / TensorFlow Lite version
  --------------------------------------------------------------------
  This is the sketch that matches your project title exactly:
    "Deployment of a Machine Learning Based Indoor Air Quality Predictor
     on NodeMCU ESP32 Using EloquentTinyML"

  Prerequisites:
    1. Run generate_dataset.py (or supply your own real dataset.csv).
    2. Run train_model_tensorflow.py on a machine with TensorFlow installed.
       That produces model.h and normalization.h in this folder.
    3. In Arduino IDE, install these libraries (Library Manager):
         - EloquentTinyML
         - TensorFlowLite_ESP32   (or "Arduino_TensorFlowLite" depending on
           which fork your course uses — API is effectively the same)
         - DHT sensor library (Adafruit)
    4. Select Board: "ESP32 Dev Module" (or your specific NodeMCU-32S entry).
    5. Open this .ino, model.h and normalization.h must sit alongside it.

  Wiring is identical to ../quickstart_version/ — see that file's header
  comment for the DHT22 / MQ-135 (through a level shifter) pinout.

  If model.h isn't there yet, this sketch won't compile — that's
  intentional: it forces you to actually run the training pipeline rather
  than flash on faith. Use the quickstart_version sketch in the meantime.
*/

#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

#include <eloquent_tinyml.h>   // EloquentTinyML wrapper around TFLite Micro
#include "model.h"              // generated by train_model_tensorflow.py
#include "normalization.h"      // generated by train_model_tensorflow.py

// ---------------------- CONFIG ----------------------
#define DHTPIN 4
#define DHTTYPE DHT22
#define MQ135_PIN 34

#define N_INPUTS IAQ_N_FEATURES
#define N_OUTPUTS 3
// Arena size: start here and grow it if you see "AllocateTensors failed"
// in Serial — bigger models / more layers need a bigger arena.
#define TENSOR_ARENA_SIZE 8 * 1024

const char* AP_SSID = "IAQ-Predictor";
const char* AP_PASSWORD = "airquality123";
const unsigned long READ_INTERVAL_MS = 3000;
// ------------------------------------------------------

Eloquent::TinyML::TfLite<N_INPUTS, N_OUTPUTS, TENSOR_ARENA_SIZE> ml;

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

struct Reading { float temperature, humidity, gas; bool valid; };
struct Prediction { int classIndex; float probs[N_OUTPUTS]; };

Reading lastReading = {0, 0, 0, false};
Prediction lastPrediction = {0, {0, 0, 0}};

Reading readSensors() {
  Reading r;
  r.temperature = dht.readTemperature();
  r.humidity = dht.readHumidity();
  r.valid = !(isnan(r.temperature) || isnan(r.humidity));
  r.gas = (float)analogRead(MQ135_PIN);
  return r;
}

Prediction predictAirQuality(const Reading& r) {
  float raw[N_INPUTS] = {r.temperature, r.humidity, r.gas};
  float x[N_INPUTS];
  for (int i = 0; i < N_INPUTS; i++) {
    x[i] = (raw[i] - iaq_feature_mean[i]) / iaq_feature_std[i];
  }

  float y[N_OUTPUTS] = {0};
  ml.predict(x, y);   // EloquentTinyML runs the TFLite Micro interpreter here

  Prediction pred;
  int best = 0;
  for (int i = 0; i < N_OUTPUTS; i++) {
    pred.probs[i] = y[i];
    if (y[i] > y[best]) best = i;
  }
  pred.classIndex = best;
  return pred;
}

void handleRoot() {
  String cls = iaq_class_names[lastPrediction.classIndex];
  String color = cls == "Good" ? "#2ecc71" : (cls == "Moderate" ? "#f39c12" : "#e74c3c");

  String html = "<!DOCTYPE html><html><head><meta charset='utf-8'>";
  html += "<meta http-equiv='refresh' content='3'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<title>Indoor Air Quality (TFLite)</title>";
  html += "<style>body{font-family:sans-serif;background:#111;color:#eee;text-align:center;padding:40px}";
  html += ".card{background:#1c1c1c;border-radius:16px;padding:24px;max-width:360px;margin:0 auto}";
  html += ".status{font-size:2em;font-weight:bold;padding:16px;border-radius:12px;margin:16px 0}";
  html += ".row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #333}</style>";
  html += "</head><body><div class='card'><h2>Indoor Air Quality</h2>";
  html += "<div class='status' style='background:" + color + "'>" + cls + "</div>";
  html += "<div class='row'><span>Temperature</span><span>" + String(lastReading.temperature, 1) + " &deg;C</span></div>";
  html += "<div class='row'><span>Humidity</span><span>" + String(lastReading.humidity, 1) + " %</span></div>";
  html += "<div class='row'><span>Gas (raw ADC)</span><span>" + String(lastReading.gas, 0) + "</span></div>";
  html += "<h4>Confidence</h4>";
  for (int i = 0; i < N_OUTPUTS; i++) {
    html += "<div class='row'><span>" + String(iaq_class_names[i]) + "</span><span>" + String(lastPrediction.probs[i] * 100, 1) + "%</span></div>";
  }
  html += "</div></body></html>";
  server.send(200, "text/html", html);
}

void handleApiData() {
  server.sendHeader("Access-Control-Allow-Origin", "*");  // allow the standalone dashboard page to fetch() this

  String json = "{";
  json += "\"temperature\":" + String(lastReading.temperature, 2) + ",";
  json += "\"humidity\":" + String(lastReading.humidity, 2) + ",";
  json += "\"gas\":" + String(lastReading.gas, 1) + ",";
  json += "\"prediction\":\"" + String(iaq_class_names[lastPrediction.classIndex]) + "\",";
  json += "\"probs\":[";
  for (int i = 0; i < N_OUTPUTS; i++) {
    json += String(lastPrediction.probs[i], 4);
    if (i < N_OUTPUTS - 1) json += ",";
  }
  json += "],";
  json += "\"uptimeMs\":" + String(millis());
  json += "}";

  server.send(200, "application/json", json);
}

unsigned long lastRead = 0;

void setup() {
  Serial.begin(115200);
  dht.begin();
  analogReadResolution(12);

  // Load the quantized model into the TFLite Micro interpreter.
  if (!ml.begin(iaq_model_tflite)) {
    Serial.println("Failed to load model! Check TENSOR_ARENA_SIZE and model.h.");
    while (true) delay(1000);
  }

  WiFi.softAP(AP_SSID, AP_PASSWORD);
  Serial.print("Access point started. Browse to http://192.168.4.1 after joining '");
  Serial.print(AP_SSID);
  Serial.println("'");
  Serial.println("JSON API available at http://192.168.4.1/api/data");

  server.on("/", handleRoot);
  server.on("/api/data", handleApiData);
  server.begin();
}

void loop() {
  server.handleClient();

  if (millis() - lastRead >= READ_INTERVAL_MS) {
    lastRead = millis();
    Reading r = readSensors();
    if (!r.valid) {
      Serial.println("DHT22 read failed, skipping this cycle.");
      return;
    }
    lastReading = r;
    lastPrediction = predictAirQuality(r);

    Serial.println("----------------------------------------");
    Serial.printf("Temp: %.1f C   Hum: %.1f %%   Gas: %.0f\n",
                   r.temperature, r.humidity, r.gas);
    Serial.printf("Prediction: %s\n", iaq_class_names[lastPrediction.classIndex]);
    for (int i = 0; i < N_OUTPUTS; i++) {
      Serial.printf("  %-10s %.1f%%\n", iaq_class_names[i], lastPrediction.probs[i] * 100);
    }
  }
}
